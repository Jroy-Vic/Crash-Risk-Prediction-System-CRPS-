[Unit]
Description=CRPS Client (Inference + Data Pipeline)
After=network.target

[Service]
User=jroy_vic
WorkingDirectory=/home/jroy_vic/crps_pi_client
ExecStart=/home/jroy_vic/crps_pi_client/venv/bin/python edge/raspberry_pi/client.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target